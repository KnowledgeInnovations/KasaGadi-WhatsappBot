# ── Kasagadi AI WhatsApp Assistant — environment variables ──────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# --- WhatsApp Business Cloud API (Meta) — REQUIRED ---
# Create at developers.facebook.com > your app > WhatsApp > API Setup.
# The number itself: MTN 0597309383 must be registered/verified as a
# WhatsApp Business number in Meta Business Manager before this works.
VERIFY_TOKEN=choose-any-random-string-you-invent
WHATSAPP_TOKEN=your-permanent-access-token-from-meta
PHONE_NUMBER_ID=your-phone-number-id-from-meta

# Optional — the human-readable international number (no +), used to build
# "Chat on WhatsApp" deep links for the future kasagadi.ai dashboard button.
WHATSAPP_DISPLAY_NUMBER=233597309383

# --- Mansa AI ---
# Public endpoint, no auth required today. Override only if Mansa changes hosts
# or adds an API key requirement later.
# MANSA_BASE_URL=https://mansa-control-plane-623708969253.us-central1.run.app
# MANSA_API_KEY=

# --- Kasagadi Claims API — REQUIRED for the bot to surface real fact-checks ---
# Documented at docs.kasagadi.ai. Ask the Kasagadi team for a partner key
# (format kg_live_...). Without this, the bot still runs and chats normally,
# but every claim search comes back empty — it can never cite a published verdict.
KASAGADI_API_KEY=kg_live_your-partner-key-here
# KASAGADI_API_BASE_URL=https://kasagadi.ai/api/v1

# --- MongoDB (Atlas recommended) — REQUIRED for persistence ---
# Stores sessions/conversations, registered members, and broadcast history.
# Claims/fact-checks are NOT stored here — they're fetched live from the
# Kasagadi Claims API above. Without MONGODB_URI the bot still runs, but
# forgets everything on restart.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=kasagadi-bot

# --- Admin dashboard login (/app) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# --- Company / escalation contact ---
COMPANY_PHONE=+233597309383
COMPANY_EMAIL=hello@kasagadi.ai
COMPANY_ADDRESS=Accra, Ghana
# WhatsApp number the bot forwards "speak to a human" escalations to.
# Defaults to the bot's own number if unset — set a real human review team number.
ESCALATION_WHATSAPP=+233597309383

# --- Deployment ---
PORT=3000
# Set automatically on Render; set manually elsewhere (used for keep-alive pings + media URLs)
BASE_URL=
